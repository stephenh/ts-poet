{
  "compilerOptions": {
    "target": "ES2018",
    "module": "node16",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "rootDir": "src",
    "outDir": "build",
    "types": ["jest", "node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
